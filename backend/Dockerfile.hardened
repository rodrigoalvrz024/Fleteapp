# Experimental only. CI resolves both Community images to immutable digests.
ARG PYTHON_BUILD_IMAGE
ARG PYTHON_RUNTIME_IMAGE
FROM ${PYTHON_BUILD_IMAGE} AS build

USER 0:0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN python -m venv /opt/muvv-venv
COPY requirements.txt .
RUN /opt/muvv-venv/bin/python -m pip install --no-cache-dir --upgrade pip==26.2.1 setuptools==84.0.0 wheel==0.48.0 \
    && /opt/muvv-venv/bin/python -m pip install --no-cache-dir --only-binary=:all: -r requirements.txt
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY --chown=0:0 --chmod=0444 certs/supabase-root-2021.crt ./certs/supabase-root-2021.crt
RUN chmod -R go-w /app /opt/muvv-venv

FROM ${PYTHON_RUNTIME_IMAGE} AS trial
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV PATH="/opt/muvv-venv/bin:$PATH"
WORKDIR /app
COPY --from=build --chown=0:0 /opt/muvv-venv /opt/muvv-venv
COPY --from=build --chown=0:0 /app /app
# No shell is needed to remove this unused vulnerable terminal-analysis tool.
USER 0:0
RUN --mount=type=bind,source=docker/configure_runtime.py,target=/configure-runtime.py,readonly ["/opt/muvv-venv/bin/python", "-I", "-B", "/configure-runtime.py"]
RUN ["/opt/muvv-venv/bin/python", "-I", "-B", "-c", "import os; from pathlib import Path; os.chown('/app', 0, 0); os.chmod('/app', 0o755); [Path(p).unlink(missing_ok=True) for p in ('/usr/bin/infocmp', '/bin/infocmp')]"]
USER 65532:65532
ENTRYPOINT []
CMD ["/opt/muvv-venv/bin/python", "-m", "app.server"]

DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
SECRET_KEY=change-me-to-a-long-random-secret
APP_ENV=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Keep the real-world pilot closed until operational checks are complete.
# Separate multiple invited email addresses with commas.
PILOT_MODE=false
PILOT_ALLOWED_EMAILS=
JWT_ISSUER=muvv-api
JWT_AUDIENCE=muvv-app
CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
MAX_REQUEST_BODY_MB=10
RUN_STARTUP_MIGRATIONS=false

TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration
FIREBASE_CREDENTIALS_JSON=
# OAuth 2.0 web client ID used as the verified audience for Google Sign-In.
# This is public and is not an OAuth client secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_MAPS_KEY=
FRONTEND_URL=https://YOUR_APP_SITE.web.app
RESEND_API_KEY=
EMAIL_FROM=muvv <onboarding@resend.dev>
PASSWORD_RESET_EXPIRE_MINUTES=30
TERMS_VERSION=2026-08-26
PRIVACY_VERSION=2026-08-26
# Private Supabase Storage bucket. Keep it private and configure this only on the backend.
DRIVER_DOCUMENTS_BUCKET=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DRIVER_DOCUMENT_MAX_MB=5
DRIVER_DOCUMENT_VIEW_EXPIRE_MINUTES=10
DRIVER_REJECTED_DOCUMENT_RETENTION_DAYS=90
FREIGHT_EVIDENCE_MAX_MB=8
FREIGHT_EVIDENCE_VIEW_EXPIRE_MINUTES=10
PUBLIC_API_URL=https://YOUR_BACKEND_HOST
NOTIFICATION_TASKS_ENABLED=false
ENABLE_DRIVER_PUSH_NOTIFICATIONS=false

# Pricing v2. Leave empty to use the reviewed Muvv defaults in the backend.
# Optional JSON overlay example:
# PRICING_CONFIG_JSON={"policy":{"helper_fee":10000,"rounding_increment":100},"vehicles":{"van":{"minimum_fare":28000,"rate_per_km":1050}}}
PRICING_CONFIG_JSON=
PRICING_QUOTE_EXPIRE_MINUTES=10
PRICING_ROUTE_MAX_RETRIES=2

# Private freight chat. Images are stored in the private Supabase bucket.
CHAT_MESSAGE_MAX_LENGTH=1000
CHAT_MESSAGE_PAGE_SIZE=80
CHAT_MESSAGE_MAX_PAGE_SIZE=100
CHAT_SEND_MAX_MESSAGES_PER_MINUTE=40
CHAT_IMAGE_MAX_MB=5
CHAT_IMAGE_VIEW_EXPIRE_MINUTES=10
CHAT_IMAGE_SEND_MAX_PER_MINUTE=12
